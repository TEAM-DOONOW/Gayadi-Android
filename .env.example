# Gayadi-Android Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.
#
# NOTE: Android SDK path goes in local.properties (also gitignored), NOT here.
#   Example local.properties:
#     sdk.dir=/home/yourname/android-sdk        # Linux/WSL
#     sdk.dir=C:\\Users\\you\\AppData\\Local\\Android\\Sdk  # Windows

# Backend API base URL (Gayadi-Server)
# Use 10.0.2.2 for Android emulator → host localhost
API_BASE_URL=http://10.0.2.2:8080

# Debug / Feature flags
DEBUG_LOGGING=true
