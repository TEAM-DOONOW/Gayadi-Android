rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /surveys/travel-personality-v1 {
      allow read: if true;
      allow write: if false;

      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /legalDocuments/{documentId} {
      allow read: if documentId in ['terms-of-service', 'privacy-policy'];
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
