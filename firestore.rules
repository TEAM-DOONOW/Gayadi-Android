rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /surveys/travel-personality-v1 {
      allow read: if true;
      allow write: if false;

      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /legalDocuments/{documentId} {
      allow read: if documentId in ['terms-of-service', 'privacy-policy']
        && resource.data.publicationStatus in ['prototype', 'published'];
      allow write: if false;
    }

    // Published update notices shown in the settings screen. The app lists the whole
    // collection, so drafts are filtered out by the seeder rather than by a rule.
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if false;
    }

    // Write-only support inbox. Anyone can file an inquiry, nobody can read one back.
    match /inquiries/{inquiryId} {
      allow create: if validInquiry(request.resource.data);
      allow read, update, delete: if false;
    }

    function validInquiry(data) {
      return data.keys().hasOnly([
          'category', 'title', 'message', 'contactEmail',
          'installationId', 'appVersion', 'status', 'createdAt'
        ])
        && data.keys().hasAll([
          'category', 'title', 'message', 'contactEmail',
          'installationId', 'appVersion', 'status', 'createdAt'
        ])
        && data.category in ['bug', 'feature', 'account', 'etc']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 50
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 1000
        && data.contactEmail is string && data.contactEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
        && data.installationId is string && data.installationId.size() > 0 && data.installationId.size() <= 100
        && data.appVersion is string && data.appVersion.size() > 0 && data.appVersion.size() <= 30
        && data.status == 'RECEIVED'
        && data.createdAt == request.time;
    }

    // Public invite-code exchange for the prototype. Listing and deletion stay blocked so an
    // invite must be opened with its exact six-character code.
    match /tripInvites/{inviteCode} {
      allow get: if inviteCode.matches('^[A-Z0-9]{6}$');
      allow create, update: if validTripInvite(request.resource.data, inviteCode);
      allow list, delete: if false;
    }

    function validTripInvite(data, inviteCode) {
      return inviteCode.matches('^[A-Z0-9]{6}$')
        && data.keys().hasAll([
          'inviteCode', 'tripId', 'name', 'startDate', 'endDate', 'cities', 'status',
          'isGroupTrip', 'ownerId', 'participants', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'inviteCode', 'tripId', 'name', 'startDate', 'endDate', 'cities', 'status',
          'isGroupTrip', 'ownerId', 'participants', 'createdAt', 'updatedAt'
        ])
        && data.inviteCode == inviteCode
        && data.tripId is string && data.tripId.size() > 0 && data.tripId.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.startDate is string && data.endDate is string
        && data.cities is list && data.cities.size() > 0 && data.cities.size() <= 20
        && data.status in ['PLANNING', 'ONGOING', 'COMPLETED']
        && data.isGroupTrip is bool
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 100
        && data.participants is list
        && data.participants.size() > 0 && data.participants.size() <= 30;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
